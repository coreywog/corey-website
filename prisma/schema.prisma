generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Exercise {
  id       String     @id @default(cuid())
  name     String     @unique
  category String // e.g. "push", "pull", "legs", "cardio"
  sets     SetEntry[]
}

model WorkoutSession {
  id         String     @id @default(cuid())
  date       DateTime
  bodyweight Float?
  notes      String?
  sets       SetEntry[]
}

model SetEntry {
  id         String   @id @default(cuid())
  sessionId  String
  exerciseId String
  weight     Float
  reps       Int
  rpe        Float?
  order      Int

  session  WorkoutSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  exercise Exercise       @relation(fields: [exerciseId], references: [id])
}

model FinanceAccount {
  id       String  @id @default(cuid())
  name     String  @unique
  type     String // e.g. "checking", "savings", "investment", "credit", "loan"
  kind     String // "asset" | "liability" — sign used when summing net worth
  archived Boolean @default(false)

  // True for an account whose transactions are already fully represented
  // elsewhere — e.g. PayPal, when checkout charges a linked card directly
  // rather than a stored balance: Plaid then shows the same purchase twice
  // (once on PayPal, once on the card, a day or two later, exact amount).
  // Excluded from cash-flow sums so spending isn't double-counted, but the
  // account and its transactions are kept for browsing.
  excludeFromCashFlow Boolean @default(false)

  // Set only for accounts synced live via Plaid, rather than imported by
  // hand from statement exports. plaidAccountId is Plaid's own per-account
  // id (routes synced transactions to the right FinanceAccount); several
  // FinanceAccounts can share one PlaidItem (one bank login can expose
  // multiple accounts, e.g. checking + savings).
  plaidItemId    String?
  plaidItem      PlaidItem? @relation(fields: [plaidItemId], references: [id])
  plaidAccountId String?    @unique

  balances     BalanceEntry[]
  transactions Transaction[]
}

// One Plaid Link connection (one bank login) — can expose multiple
// FinanceAccounts. accessToken is the credential that lets us pull data
// for this connection indefinitely until the user revokes access, so it's
// treated at least as sensitively as amount/description (see lib/crypto.ts).
model PlaidItem {
  id              String    @id @default(cuid())
  itemId          String    @unique // Plaid's item_id
  accessToken     String // AES-256-GCM ciphertext (base64), never plaintext
  institutionName String?
  // /transactions/sync cursor — null means "never synced yet, pull everything".
  cursor       String?
  lastSyncedAt DateTime?
  createdAt    DateTime  @default(now())

  accounts FinanceAccount[]
}

// A learned correction from the Review tab (app/(site)/finance/review):
// "any transaction whose description contains `pattern` belongs to
// merchantCategory/merchantSubcategory." Applied immediately to every
// existing matching transaction, and checked ahead of the static
// lib/merchantClassify.ts patterns on every future Plaid sync — so fixing
// a merchant once fixes it everywhere, past and future. Pattern matching
// is a plain case-insensitive substring test (see lib/merchantRules.ts),
// not a regex — kept simple since it's user-authored, not developer-authored.
model MerchantCategoryRule {
  id                  String   @id @default(cuid())
  pattern             String
  merchantCategory    String
  merchantSubcategory String
  createdAt           DateTime @default(now())

  @@unique([pattern])
}

model Transaction {
  id        String   @id @default(cuid())
  accountId String
  date      DateTime
  amount    String // AES-256-GCM ciphertext (base64) — see lib/crypto.ts, never plaintext
  category  String // "income" | "spending" | "other" | "transfer" (transfer = excluded from cash flow)

  // Three-level spending taxonomy, only set for category="spending":
  //   merchantCategory    — broad umbrella, e.g. "food", "transport"
  //   merchantSubcategory — narrower type, e.g. "groceries", "dining"
  //   description         — the actual merchant/store, e.g. "Trader Joe's"
  // merchantCategory/merchantSubcategory start from a best-effort keyword
  // classification in scripts/extract_statements.py and get refined by hand.
  // description is AES-256-GCM ciphertext (base64, same scheme as amount) —
  // as of 2026-08, the raw merchant text is retained (encrypted) so
  // individual transactions can be reviewed and categorized; rows imported
  // before this change have description = null since the old pipeline
  // discarded it before it ever reached the database.
  merchantCategory    String?
  merchantSubcategory String?
  description         String?

  // Richer detail available only from a live Plaid sync (statement imports
  // have no equivalent — banks' PDF/CSV exports don't include any of this).
  // All encrypted the same way as `description`, since they're just as
  // derived-from-your-spending as the merchant name itself.
  //   rawName  — Plaid's uncleaned `name`, often more specific than the
  //              cleaned `description` (order/location codes, etc.)
  //   location — "City, Region" from Plaid's location object, when present
  // plaidDetailedCategory is Plaid's own classification (e.g.
  // "FOOD_AND_DRINK_COFFEE") and paymentChannel ("online"/"in store"/
  // "other") are left unencrypted — they're generic classification labels,
  // not free text about where you actually shop.
  rawName               String?
  location              String?
  paymentChannel        String?
  plaidDetailedCategory String?

  // SHA-256 of the source statement's raw date+description+amount — lets the
  // local import script skip re-importing a transaction it's already seen.
  // For Plaid-synced rows this is sha256(plaidTransactionId) instead, so
  // both import paths share the same accountId+dedupeHash uniqueness rule.
  dedupeHash String

  // Present only for rows that came from a live Plaid sync — Plaid's own
  // stable transaction_id, used to find and update/delete this row again
  // when a later sync reports it as modified or removed.
  plaidTransactionId String? @unique

  account FinanceAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, dedupeHash])
  @@index([accountId, date])
}

model BalanceEntry {
  id        String   @id @default(cuid())
  accountId String
  date      DateTime
  balance   String // AES-256-GCM ciphertext (base64) — see lib/crypto.ts, never plaintext

  account FinanceAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, date])
}
