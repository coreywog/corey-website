generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// A user-built collection of widgets — the customizable dashboard builder.
// Deliberately single-user (no owner/userId field) — matches every other
// model in this schema; the site has exactly one admin.
model Dashboard {
  id        String   @id @default(cuid())
  name      String   @unique
  order     Int      @default(0)
  // false ("editing") shows drag/resize handles and the add/edit/delete
  // controls; true ("published") renders the grid read-only so it can't be
  // accidentally rearranged while just viewing it.
  published Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tabs DashboardTab[]
}

// One tab within a Dashboard — its own named grid of widgets (think browser
// tabs: switching tabs swaps the whole grid below, not just a filter on one
// shared grid). Every dashboard has at least one tab; deleting a dashboard's
// last remaining tab is blocked at the API layer, not here.
model DashboardTab {
  id          String   @id @default(cuid())
  dashboardId String
  name        String
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  dashboard Dashboard         @relation(fields: [dashboardId], references: [id], onDelete: Cascade)
  widgets   DashboardWidget[]

  @@index([dashboardId])
}

// One chart/stat/table tile on a DashboardTab's grid.
model DashboardWidget {
  id    String  @id @default(cuid())
  tabId String
  type  String // "line" | "bar" | "pie" | "stat" | "table"
  title String? // null = auto-generated label (see lib/dashboardConfig.ts)

  // Grid units (react-grid-layout's x/y/w/h), not pixels — the persisted
  // layout round-trips straight onto react-grid-layout's own {x,y,w,h,i}.
  x Int
  y Int
  w Int
  h Int

  // The data-binding config (dataSource/metric/groupBy/dateRange/filters —
  // see lib/dashboardConfig.ts) is JSON, not relational columns: its shape
  // genuinely varies by widget type and is meant to grow over time, which a
  // fixed relational shape would fight. Validated with zod on every write;
  // read defensively (a bad/stale config renders one broken tile, not a
  // crashed page). configVersion is insurance for a future breaking
  // config-shape change — always 1 today.
  configVersion Int  @default(1)
  config        Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tab DashboardTab @relation(fields: [tabId], references: [id], onDelete: Cascade)

  @@index([tabId])
}

model Exercise {
  id       String     @id @default(cuid())
  name     String     @unique
  category String // e.g. "push", "pull", "legs", "cardio"
  sets     SetEntry[]
}

model WorkoutSession {
  id         String     @id @default(cuid())
  date       DateTime
  bodyweight Float?
  notes      String?
  sets       SetEntry[]
}

model SetEntry {
  id         String @id @default(cuid())
  sessionId  String
  exerciseId String
  weight     Float
  reps       Int
  rpe        Float?
  order      Int

  session  WorkoutSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  exercise Exercise       @relation(fields: [exerciseId], references: [id])
}

model FinanceAccount {
  id       String  @id @default(cuid())
  name     String  @unique
  type     String // e.g. "checking", "savings", "investment", "credit", "loan"
  kind     String // "asset" | "liability" — sign used when summing net worth
  archived Boolean @default(false)

  // True for an account whose transactions are already fully represented
  // elsewhere — e.g. PayPal, when checkout charges a linked card directly
  // rather than a stored balance: Plaid then shows the same purchase twice
  // (once on PayPal, once on the card, a day or two later, exact amount).
  // Excluded from cash-flow sums so spending isn't double-counted, but the
  // account and its transactions are kept for browsing.
  excludeFromCashFlow Boolean @default(false)

  // Set only for accounts synced live via Plaid, rather than imported by
  // hand from statement exports. plaidAccountId is Plaid's own per-account
  // id (routes synced transactions to the right FinanceAccount); several
  // FinanceAccounts can share one PlaidItem (one bank login can expose
  // multiple accounts, e.g. checking + savings).
  plaidItemId    String?
  plaidItem      PlaidItem? @relation(fields: [plaidItemId], references: [id])
  plaidAccountId String?    @unique

  balances     BalanceEntry[]
  transactions Transaction[]
}

// One Plaid Link connection (one bank login) — can expose multiple
// FinanceAccounts. accessToken is the credential that lets us pull data
// for this connection indefinitely until the user revokes access, so it's
// treated at least as sensitively as amount/description (see lib/crypto.ts).
model PlaidItem {
  id              String    @id @default(cuid())
  itemId          String    @unique // Plaid's item_id
  accessToken     String // AES-256-GCM ciphertext (base64), never plaintext
  institutionName String?
  // /transactions/sync cursor — null means "never synced yet, pull everything".
  cursor          String?
  lastSyncedAt    DateTime?
  createdAt       DateTime  @default(now())

  accounts FinanceAccount[]
}

// A learned correction from the Review tab (app/(site)/finance/review):
// "any transaction whose description contains `pattern` belongs to
// merchantCategory/merchantSubcategory." Applied immediately to every
// existing matching transaction, and checked ahead of the static
// lib/merchantClassify.ts patterns on every future Plaid sync — so fixing
// a merchant once fixes it everywhere, past and future. Pattern matching
// is a plain case-insensitive substring test (see lib/merchantRules.ts),
// not a regex — kept simple since it's user-authored, not developer-authored.
//
// exactAmount narrows a rule from "every transaction with this name" to
// "every transaction with this name AND this exact dollar amount" — for
// telling apart e.g. a recurring BMW loan payment (same name, same amount
// every month) from an occasional BMW service charge that happens to share
// the same merchant name but not the amount. Null means match on name alone.
model MerchantCategoryRule {
  id                  String   @id @default(cuid())
  pattern             String
  exactAmount         Float?
  merchantCategory    String
  merchantSubcategory String
  createdAt           DateTime @default(now())

  @@unique([pattern, exactAmount])
}

// A cached AI guess for one merchant name (see lib/merchantAiClassify.ts) —
// only ever queried, and written to, when the static classifier and Plaid's
// own category both come up empty for a transaction. merchantName is the
// exact-match cache key (lowercased bare merchant name — never the full
// transaction description, amount, date, or account), so the same merchant
// is only ever sent to the AI once, no matter how many transactions share
// it. Just as unconfirmed as any other guess — a match here does not set
// Transaction.reviewed.
model MerchantAiGuess {
  id                  String   @id @default(cuid())
  merchantName        String   @unique
  merchantCategory    String
  merchantSubcategory String
  createdAt           DateTime @default(now())
}

model Transaction {
  id        String   @id @default(cuid())
  accountId String
  date      DateTime
  amount    String // AES-256-GCM ciphertext (base64) — see lib/crypto.ts, never plaintext
  category  String // "income" | "spending" | "other" | "transfer" (transfer = excluded from cash flow)

  // Three-level spending taxonomy, only set for category="spending":
  //   merchantCategory    — broad umbrella, e.g. "food", "transport"
  //   merchantSubcategory — narrower type, e.g. "groceries", "dining"
  //   description         — the actual merchant/store, e.g. "Trader Joe's"
  // merchantCategory/merchantSubcategory start from a best-effort keyword
  // classification in scripts/extract_statements.py and get refined by hand.
  // description is AES-256-GCM ciphertext (base64, same scheme as amount) —
  // as of 2026-08, the raw merchant text is retained (encrypted) so
  // individual transactions can be reviewed and categorized; rows imported
  // before this change have description = null since the old pipeline
  // discarded it before it ever reached the database.
  merchantCategory    String?
  merchantSubcategory String?
  description         String?

  // Richer detail available only from a live Plaid sync (statement imports
  // have no equivalent — banks' PDF/CSV exports don't include any of this).
  // All encrypted the same way as `description`, since they're just as
  // derived-from-your-spending as the merchant name itself.
  //   rawName  — Plaid's uncleaned `name`, often more specific than the
  //              cleaned `description` (order/location codes, etc.)
  //   location — "Address, City, Region" from Plaid's location object
  //   website  — the merchant's own site, when Plaid's enrichment found one
  // plaidDetailedCategory is Plaid's own classification (e.g.
  // "FOOD_AND_DRINK_COFFEE") and paymentChannel ("online"/"in store"/
  // "other") are left unencrypted — they're generic classification labels,
  // not free text about where you actually shop.
  rawName               String?
  location              String?
  website               String?
  paymentChannel        String?
  plaidDetailedCategory String?

  // True once a human has explicitly confirmed merchantCategory/
  // merchantSubcategory are correct (via the Review tab's per-transaction
  // approve, or because a MerchantCategoryRule — itself human-authored —
  // produced the classification). False means "just a guess from the
  // static classifier, or nothing matched at all" — both need a look.
  // Existing transactions as of this field's introduction were grandfathered
  // to true if they already had a real category, so this doesn't suddenly
  // dump hundreds of already-trusted transactions into the review queue.
  reviewed Boolean @default(false)

  // SHA-256 of the source statement's raw date+description+amount — lets the
  // local import script skip re-importing a transaction it's already seen.
  // For Plaid-synced rows this is sha256(plaidTransactionId) instead, so
  // both import paths share the same accountId+dedupeHash uniqueness rule.
  dedupeHash String

  // Present only for rows that came from a live Plaid sync — Plaid's own
  // stable transaction_id, used to find and update/delete this row again
  // when a later sync reports it as modified or removed.
  plaidTransactionId String? @unique

  account FinanceAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, dedupeHash])
  @@index([accountId, date])
}

model BalanceEntry {
  id        String   @id @default(cuid())
  accountId String
  date      DateTime
  balance   String // AES-256-GCM ciphertext (base64) — see lib/crypto.ts, never plaintext

  account FinanceAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, date])
}

// A user-uploaded dataset (CSV today; other sources later) — the Data
// Management Hub's non-Finance tabs. `columns` is JSON rather than a
// relational table since the shape is genuinely arbitrary per upload (a
// fitness export and a budget spreadsheet share nothing), same reasoning
// as DashboardWidget.config above.
model Dataset {
  id        String   @id @default(cuid())
  name      String   @unique
  order     Int      @default(0)
  columns   Json // [{ name: string, kind: "text" | "number" | "date" }]
  createdAt DateTime @default(now())

  rows DatasetRow[]
}

// One uploaded row. `data` is the whole row (every column's value, keyed by
// column name) as a single AES-256-GCM ciphertext — one encrypt/decrypt
// call per row rather than one per cell, since an upload can be wide
// (dozens of columns) and this is on the hot path for viewing a dataset.
// Uploaded data could be anything (health metrics, another export of
// financial data, ...) so it's treated at least as carefully as the
// Transaction data already in this schema.
model DatasetRow {
  id        String   @id @default(cuid())
  datasetId String
  data      String
  createdAt DateTime @default(now())

  dataset Dataset @relation(fields: [datasetId], references: [id], onDelete: Cascade)

  @@index([datasetId])
}
