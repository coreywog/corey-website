# Copy this file to .env and fill in real values. Never commit .env.

# Postgres connection string (Neon, once provisioned in Phase 0 hosting step)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Shared secret for the /admin entry form (Phase 2) — pick any long random string
ADMIN_PASSWORD="change-me"

# Secret used to sign the admin session cookie (Phase 2) — long random string,
# e.g. `openssl rand -base64 32` or `node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"`
SESSION_SECRET="change-me-too"
