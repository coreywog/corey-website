# Copy this file to .env and fill in real values. Never commit .env.

# Postgres connection string (Neon, once provisioned in Phase 0 hosting step)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Single admin login — the only account, no signup flow
ADMIN_USERNAME="change-me"
ADMIN_PASSWORD="change-me"

# Secret used to sign the admin session cookie (Phase 2) — long random string,
# e.g. `openssl rand -base64 32` or `node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"`
SESSION_SECRET="change-me-too"

# AES-256-GCM key for encrypting finance balances at rest — must be a base64
# string decoding to exactly 32 bytes. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY="change-me-again"

# Plaid (Team Settings -> Keys in the Plaid dashboard). PLAID_ENV selects
# which secret to use: "sandbox" for fake test banks, "production" for real
# accounts. Start in sandbox — see app/api/plaid/.
PLAID_CLIENT_ID="change-me"
PLAID_SECRET="change-me"
PLAID_ENV="sandbox"
# Both optional, and only meaningful in production/development: an HTTPS URL
# registered in the Plaid dashboard (Team Settings -> API -> Allowed redirect
# URIs) -- required for OAuth institutions like Chase. Leave unset in sandbox.
PLAID_REDIRECT_URI=""
# Public HTTPS endpoint Plaid POSTs webhooks to -- normally
# "https://<your-domain>/api/plaid/webhook". Leave unset if testing against
# a local dev server Plaid can't reach; use "Sync now" manually instead.
PLAID_WEBHOOK_URL=""
